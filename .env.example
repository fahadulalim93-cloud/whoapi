PORT=3000

# optional: route m3u8 manifests through the bundled go proxy
# run it first: cd go-proxy && go run main.go   (listens on :8096)
GO_PROXY_URL=

# flaresolverr, required by gotaku / anizone / anihq, fallback for xanime + animeonsen
# docker run -d --name flaresolverr -p 8191:8191 ghcr.io/flaresolverr/flaresolverr:latest
FLARESOLVERR_URL=

# anipm needs the python sidecar for cloudflare-protected cdns
# run it first: cd anipm-proxy && pip install -r requirements.txt && python app.py  (:8095)
ANIPM_PROXY_URL=http://127.0.0.1:8095

# public base the anipm sidecar rewrites manifest urls to (segment/key proxying)
ANIPM_PUBLIC_BASE=http://127.0.0.1:8095

# nexus api base, override if the default host blocks your ip
NEXUS_API=https://api.anime.nexus
